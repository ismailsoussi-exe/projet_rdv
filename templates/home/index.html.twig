{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<section class="hero">
    <div class="container hero-grid">
        <div class="hero-text">
            <span class="eyebrow">{{ semestre }} · Inscriptions ouvertes</span>
            <h1>Réservez votre oral de langue <span class="accent">en deux minutes.</span></h1>
            <p class="lead">
                Choisissez votre langue, votre enseignant et un créneau libre.
                Pas de compte à créer : votre adresse mail de la Catho suffit.
            </p>
            <div class="hero-actions">
                <a href="/reserver" class="btn btn-primary">Prendre rendez-vous <span aria-hidden="true">→</span></a>
                <a href="#fonctionnement" class="btn btn-ghost">Comment ça marche</a>
            </div>
            <ul class="hero-facts">
                <li><strong>Samedi</strong><span>13h – 19h</span></li>
                <li><strong>30 min</strong><span>par oral</span></li>
                <li><strong>3 langues</strong><span>au choix</span></li>
            </ul>
        </div>

        <div class="hero-card" aria-hidden="true">
            <div class="ticket">
                <div class="ticket-head">
                    <span class="tag tag-en">EN</span>
                    <span class="ticket-label">Votre oral</span>
                </div>
                <p class="ticket-date">Samedi</p>
                <p class="ticket-time">14:30 <small>– 15:00</small></p>
                <div class="ticket-slots">
                    {% for h in ['13:00','13:30','14:00','14:30','15:00','15:30','16:00','16:30','17:00','17:30','18:00','18:30'] %}
                        <span class="slot {{ h == '14:30' ? 'is-picked' : (loop.index is divisible by(3) ? 'is-taken') }}">{{ h }}</span>
                    {% endfor %}
                </div>
                <p class="ticket-foot">prenom.nom@univ-catholille.fr</p>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="section-head">
            <h2>Choisissez votre langue</h2>
            <p class="muted">Un oral par langue et par semestre.</p>
        </div>
        <div class="lang-grid">
            {% for langue in langues %}
                <a href="/reserver?langue={{ langue.classe }}" class="lang-card lang-{{ langue.classe }}">
                    <span class="lang-code">{{ langue.code }}</span>
                    <span class="lang-name">{{ langue.nom }}</span>
                    <span class="lang-quote">« {{ langue.accroche }} »</span>
                    <span class="lang-cta">Réserver <span aria-hidden="true">→</span></span>
                </a>
            {% endfor %}
        </div>
    </div>
</section>

<section class="section section-alt" id="fonctionnement">
    <div class="container">
        <div class="section-head">
            <h2>Comment ça marche</h2>
            <p class="muted">Quatre étapes, sans inscription.</p>
        </div>
        <ol class="steps">
            <li><span class="step-num">1</span><h3>La langue</h3><p>Anglais, allemand ou espagnol.</p></li>
            <li><span class="step-num">2</span><h3>L'enseignant</h3><p>Seuls les enseignants de la langue choisie s'affichent.</p></li>
            <li><span class="step-num">3</span><h3>Le créneau</h3><p>Un samedi, entre 13h et 19h. Les créneaux pris sont grisés.</p></li>
            <li><span class="step-num">4</span><h3>Vos coordonnées</h3><p>Nom, prénom et adresse @univ-catholille.fr.</p></li>
        </ol>
    </div>
</section>

<section class="section">
    <div class="container">
        <div class="notice">
            <div class="notice-icon" aria-hidden="true">!</div>
            <div>
                <h3>Avant de réserver</h3>
                <ul>
                    <li>Seules les adresses <strong>@univ-catholille.fr</strong> sont acceptées.</li>
                    <li>Une réservation est <strong>définitive</strong> : vous ne pourrez ni la modifier ni l'annuler vous-même.</li>
                    <li>En cas d'empêchement, contactez le secrétariat : seul l'administrateur peut déplacer ou supprimer un rendez-vous.</li>
                </ul>
            </div>
        </div>
    </div>
</section>
{% endblock %}