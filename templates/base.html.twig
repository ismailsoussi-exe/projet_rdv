<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Oraux de langues{% endblock %} · UCL</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,600;0,8..60,700;1,8..60,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a href="/" class="brand">
                <img src="{{ asset('images/logo-ucl.png') }}" alt="Université Catholique de Lille" class="brand-logo">
                <span class="brand-sep" aria-hidden="true"></span>
                <span class="brand-text">Oraux <em>de langues</em></span>
            </a>
            <nav class="nav">
                <a href="/" class="{{ app.request.pathInfo == '/' ? 'active' }}">Accueil</a>
                <a href="/reserver">Prendre rendez-vous</a>
                <a href="/admin" class="nav-admin">Espace admin</a>
            </nav>
        </div>
    </header>

    <main>
        {% for type, messages in app.flashes %}
            <div class="container">
                {% for message in messages %}
                    <div class="flash flash-{{ type }}">{{ message }}</div>
                {% endfor %}
            </div>
        {% endfor %}

        {% block body %}{% endblock %}
    </main>

    <footer class="site-footer">
        <div class="container footer-inner">
            <div class="footer-brand">
                <img src="{{ asset('images/logo-ucl.png') }}" alt="Université Catholique de Lille" class="footer-logo">
                <p>Oraux de langues · Anglais, allemand, espagnol</p>
            </div>
            <p class="muted">Une question sur votre rendez-vous ? Contactez le secrétariat des langues.</p>
        </div>
    </footer>

    {% block javascripts %}{% endblock %}
</body>
</html>